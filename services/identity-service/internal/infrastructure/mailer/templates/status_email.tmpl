{{define "subject"}}
Your RoutePulse verification code
{{end}}

{{define "body"}}
<!doctype html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      background-color: #f3f4f6;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 560px;
      margin: 32px auto;
      background: #ffffff;
      padding: 32px;
      border-radius: 10px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.06);
    }
    .header {
      text-align: center;
      margin-bottom: 24px;
    }
    .logo {
      font-size: 22px;
      font-weight: 700;
      color: #2563eb;
      letter-spacing: 0.5px;
    }
    .subtitle {
      font-size: 14px;
      color: #6b7280;
      margin-top: 4px;
    }
    .code-box {
      margin: 28px 0;
      padding: 16px;
      text-align: center;
      background: #f8fafc;
      border: 1px dashed #c7d2fe;
      border-radius: 8px;
    }
    .code {
      font-size: 28px;
      font-weight: 700;
      letter-spacing: 4px;
      color: #1e3a8a;
    }
    .text {
      font-size: 15px;
      color: #374151;
      line-height: 1.6;
    }
    .expiry {
      margin-top: 12px;
      font-size: 14px;
      color: #b45309;
      text-align: center;
    }
    .footer {
      margin-top: 36px;
      padding-top: 16px;
      border-top: 1px solid #e5e7eb;
      font-size: 12px;
      color: #9ca3af;
      text-align: center;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="header">
      <div class="logo">RoutePulse</div>
      <div class="subtitle">Secure account verification</div>
    </div>

    <p class="text">
      Hello,
    </p>

    <p class="text">
      Use the verification code below to complete your request on <strong>RoutePulse</strong>.
    </p>

    <div class="code-box">
      <div class="code">{{.Code}}</div>
    </div>

    <div class="expiry">
      This code expires in {{.ExpiresIn}} minutes.
    </div>

    <p class="text">
      If you did not request this verification, you can safely ignore this email.
    </p>

    <div class="footer">
      © {{.Year}} RoutePulse. All rights reserved.
    </div>
  </div>
</body>
</html>
{{end}}
